{
  "name": "befukre-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BEFUKRE — cocktail club. Design system + marketing site.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens": "node --experimental-strip-types scripts/generate-tokens.ts"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lenis": "^1.3.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.21",
    "@storybook/addon-docs": "^9.1.21",
    "@storybook/react-vite": "^9.1.21",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "storybook": "^9.1.21",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
